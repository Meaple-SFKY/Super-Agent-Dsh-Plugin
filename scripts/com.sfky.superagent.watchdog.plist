<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for a per-user macOS LaunchAgent that runs the Superagent watchdog.

  Do not edit this file in place: `scripts/install-launchd.sh` renders it into
  ~/Library/LaunchAgents/__LABEL__.plist with the real paths. The agent runs
  once at login and then every StartInterval seconds. KeepAlive restarts the
  watchdog process only when it exits with a failure (SuccessfulExit false), so
  a crash in the watcher does not silently disable it, while a normal check
  stays a normal check. The watchdog writes its own log under the state
  directory, so launchd's stdout/stderr are discarded.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__WATCHDOG__</string>
    <string>--state-dir</string>
    <string>__STATE_DIR__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>SUPERAGENT_STATE_DIR</key>
    <string>__STATE_DIR__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>120</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/dev/null</string>

  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
